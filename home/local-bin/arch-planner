#!/bin/bash

# ============================================================================
# Arch Event Planner
# Système de planification et rappels pour Arch Linux
# ============================================================================

set -euo pipefail

# Configuration globale
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly CONFIG_DIR="$HOME/.arch_planner"
readonly LIB_DIR="/home/omnimessie/github/my_planning/lib"

# Import des modules
source "$LIB_DIR/config.sh"
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/events.sh"
source "$LIB_DIR/notifications.sh"
source "$LIB_DIR/reminders.sh"

# ============================================================================
# Vérification des dépendances
# ============================================================================

check_dependencies() {
  local missing_deps=()

  for dep in gum jq at notify-send; do
    if ! command -v "$dep" &>/dev/null; then
      missing_deps+=("$dep")
    fi
  done

  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    ui_error "Dépendances manquantes: ${missing_deps[*]}"
    ui_info "Installation: sudo pacman -S ${missing_deps[*]// libnotify/ libnotify}"
    exit 1
  fi

  # Vérifier que le service atd est actif
  if ! systemctl is-active --quiet atd; then
    ui_warning "Service 'atd' non démarré"
    if ui_confirm "Voulez-vous démarrer le service atd automatiquement ?"; then
      sudo systemctl enable --now atd
      ui_success "Service atd démarré et activé"
    else
      ui_error "Le service atd est requis pour programmer les événements"
      exit 1
    fi
  fi
}

# ============================================================================
# Menu principal
# ============================================================================

show_main_menu() {
  local upcoming_count
  upcoming_count=$(events_count_upcoming)

  echo
  echo -e "${CYAN}Menu Principal - Arch Event Planner${NC}"

  if [[ $upcoming_count -gt 0 ]]; then
    echo -e "${GREEN}📅 $upcoming_count événement(s) à venir${NC}"
  else
    echo -e "${YELLOW}📅 Aucun événement programmé${NC}"
  fi
  echo

  local menu_options=(
    "➕ Créer un événement"
    "📅 Voir les événements à venir"
    "🔔 Créer un rappel simple"
    "📋 Gérer tous les événements"
    "⏰ Événements récurrents"
    "🗑️ Nettoyer les anciens événements"
    "⚙️ Paramètres"
    "🚪 Quitter"
  )

  gum choose \
    --cursor="➤ " \
    --selected.foreground="#00ff00" \
    --cursor.foreground="#0099ff" \
    "${menu_options[@]}"
}

handle_main_menu() {
  local choice="$1"

  case "$choice" in
  *"Créer un événement"*)
    events_create_interactive
    ;;
  *"Voir les événements"*)
    events_show_upcoming
    ;;
  *"rappel simple"*)
    reminders_create_quick
    ;;
  *"Gérer tous"*)
    events_manage_all
    ;;
  *"récurrents"*)
    events_manage_recurring
    ;;
  *"Nettoyer"*)
    events_cleanup_old
    ;;
  *"Paramètres"*)
    show_settings_menu
    ;;
  *"Quitter"*)
    ui_success "Au revoir ! Planificateur fermé."
    exit 0
    ;;
  *)
    ui_warning "Option non reconnue"
    ;;
  esac
}

# ============================================================================
# Menu des paramètres
# ============================================================================

show_settings_menu() {
  ui_header "⚙️ Paramètres"

  echo
  local settings_choice
  settings_choice=$(gum choose \
    --cursor="➤ " \
    --selected.foreground="#00ff00" \
    --cursor.foreground="#0099ff" \
    "🔔 Configuration des notifications" \
    "⏰ Paramètres des rappels" \
    "📊 Voir les statistiques d'utilisation" \
    "🗂️ Exporter les événements" \
    "📥 Importer des événements" \
    "🔄 Réinitialiser la configuration" \
    "↩️ Retour au menu principal")

  case "$settings_choice" in
  *"notifications"*)
    settings_configure_notifications
    ;;
  *"rappels"*)
    settings_configure_reminders
    ;;
  *"statistiques"*)
    show_usage_statistics
    ;;
  *"Exporter"*)
    events_export
    ;;
  *"Importer"*)
    events_import
    ;;
  *"Réinitialiser"*)
    if ui_confirm "Êtes-vous sûr de vouloir réinitialiser la configuration ?"; then
      config_reset
      ui_success "Configuration réinitialisée"
    fi
    ;;
  *"Retour"*)
    return
    ;;
  esac

  echo
  ui_wait
}

settings_configure_notifications() {
  ui_header "Configuration des Notifications"

  local enabled sound_enabled priority
  enabled=$(config_get '.notifications.enabled')
  sound_enabled=$(config_get '.notifications.sound')
  priority=$(config_get '.notifications.priority')

  echo
  ui_info "Configuration actuelle :"
  echo "  Notifications: $([ "$enabled" = "true" ] && echo "Activées" || echo "Désactivées")"
  echo "  Sons: $([ "$sound_enabled" = "true" ] && echo "Activés" || echo "Désactivés")"
  echo "  Priorité: $priority"
  echo

  local choice
  choice=$(gum choose \
    "$([ "$enabled" = "true" ] && echo "🔴 Désactiver" || echo "🟢 Activer") les notifications" \
    "$([ "$sound_enabled" = "true" ] && echo "🔇 Désactiver" || echo "🔊 Activer") les sons" \
    "📊 Modifier la priorité par défaut" \
    "🧪 Tester les notifications" \
    "↩️ Retour")

  case "$choice" in
  *"Désactiver les notifications"*)
    config_set '.notifications.enabled' false
    ui_success "Notifications désactivées"
    ;;
  *"Activer les notifications"*)
    config_set '.notifications.enabled' true
    ui_success "Notifications activées"
    ;;
  *"Désactiver les sons"*)
    config_set '.notifications.sound' false
    ui_success "Sons désactivés"
    ;;
  *"Activer les sons"*)
    config_set '.notifications.sound' true
    ui_success "Sons activés"
    ;;
  *"priorité"*)
    local new_priority
    new_priority=$(gum choose "low" "normal" "critical")
    config_set '.notifications.priority' "$new_priority"
    ui_success "Priorité mise à jour: $new_priority"
    ;;
  *"Tester"*)
    notifications_test
    ;;
  esac
}

settings_configure_reminders() {
  ui_header "Paramètres des Rappels"

  local default_before snooze_duration
  default_before=$(config_get '.reminders.default_before')
  snooze_duration=$(config_get '.reminders.snooze_duration')

  echo
  ui_info "Configuration actuelle :"
  echo "  Rappel par défaut: $default_before minutes avant"
  echo "  Durée du snooze: $snooze_duration minutes"
  echo

  local choice
  choice=$(gum choose \
    "⏰ Modifier le rappel par défaut" \
    "💤 Modifier la durée du snooze" \
    "↩️ Retour")

  case "$choice" in
  *"rappel par défaut"*)
    local new_default
    new_default=$(ui_input "Rappel par défaut (minutes avant l'événement)" "$default_before")
    if [[ "$new_default" =~ ^[0-9]+$ ]]; then
      config_set '.reminders.default_before' "$new_default"
      ui_success "Rappel par défaut mis à jour"
    else
      ui_error "Valeur invalide"
    fi
    ;;
  *"snooze"*)
    local new_snooze
    new_snooze=$(ui_input "Durée du snooze (minutes)" "$snooze_duration")
    if [[ "$new_snooze" =~ ^[0-9]+$ ]]; then
      config_set '.reminders.snooze_duration' "$new_snooze"
      ui_success "Durée du snooze mise à jour"
    else
      ui_error "Valeur invalide"
    fi
    ;;
  esac
}

show_usage_statistics() {
  ui_header "📊 Statistiques d'Utilisation"

  local total_events upcoming_events completed_events
  total_events=$(events_count_total)
  upcoming_events=$(events_count_upcoming)
  completed_events=$(events_count_completed)

  ui_box "📈 STATISTIQUES" \
    "Total des événements créés: $total_events|Événements à venir: $upcoming_events|Événements passés: $completed_events||Utilisation système:|Service atd: $(systemctl is-active atd)|Notifications: $(config_get '.notifications.enabled')|Dernière utilisation: $(date)" \
    "#4A90E2"

  echo
  ui_wait
}

# ============================================================================
# Affichage des événements à venir
# ============================================================================

show_upcoming_events() {
  local events_data
  events_data=$(events_get_upcoming)

  if [[ "$events_data" == "[]" ]] || [[ -z "$events_data" ]]; then
    ui_info "📅 Aucun événement programmé"
    return 0
  fi

  echo
  ui_info "📅 Événements à venir :"
  echo

  # Afficher chaque événement
  echo "$events_data" | jq -r '.[] | "\(.date_time) - \(.title) (\(.type))"' | while read -r line; do
    echo "  $line"
  done
}

# ============================================================================
# Boucle principale
# ============================================================================

main_loop() {
  while true; do
    ui_header "Arch Event Planner"

    # Afficher les événements à venir (résumé)
    show_upcoming_events

    local choice
    if ! choice=$(show_main_menu); then
      ui_warning "Sélection annulée"
      continue
    fi

    handle_main_menu "$choice"

    echo
    sleep 0.5
  done
}

# ============================================================================
# Point d'entrée principal
# ============================================================================

main() {
  check_dependencies
  config_init

  mkdir -p "$CONFIG_DIR"

  echo
  ui_success "Arch Event Planner initialisé"
  echo

  # Vérifier les événements imminent au démarrage
  events_check_immediate

  main_loop
}

# Gestion des signaux
trap 'echo; ui_warning "Interruption détectée. Session fermée."; exit 130' INT TERM

# Lancer le programme
main "$@"
