{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "cyan",
      "2": "blue"
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "os",
      "key": "  {icon}  OS"
    },
    {
      "type": "kernel",
      "key": "  {icon}  Kernel"
    },
    {
      "type": "uptime",
      "key": "  {icon}  Uptime"
    },
    {
      "type": "packages",
      "key": "  {icon}  Packages"
    },
    {
      "type": "memory",
      "key": "  {icon}  Memory"
    },
    {
      "type": "wm",
      "key": "  {icon}  WM"
    },
    {
      "type": "users",
      "key": "  {icon}  Login"
    },
    {
      "type": "colors",
      "key": "  {icon}  Colors",
      "symbol": "circle"
    }
  ]
}
